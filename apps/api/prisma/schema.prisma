// Esquema de datos de Raphael Eventos — Fase 1.
// Borrador acordado con el usuario (ver docs/ y el historial de decisiones en memoria).
// IMPORTANTE: todavía no se generó ninguna migración a partir de este schema.
// Multi-tenant de esquema compartido: tenant_id está presente en TODAS las tablas
// (incluidas las hijas) para que las políticas de Row-Level Security de Postgres
// puedan filtrar por columna propia, sin depender de joins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  BASICA
  PRO
}

enum Role {
  ADMIN
  VENDEDOR
  CLIENTE
  /// Fase 3: empleado con acceso solo al check-in de invitados de los eventos
  /// donde está asignado (EventStaffAssignment). Se crea desde
  /// /admin/personal, nunca por /registro.
  PUERTA
}

enum EventType {
  QUINCE
  EGRESO
  BODA
  EMPRESARIAL
}

enum EventStatus {
  ACTIVO
  FINALIZADO
  CANCELADO
}

enum CardType {
  ADULTO
  ADOLESCENTE
  MENOR
  BRINDIS
}

enum AccountRole {
  TITULAR
  PARTICIPANTE
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum EmployeeContractType {
  EN_BLANCO
  MONOTRIBUTO
  INFORMAL
}

enum EmployeeVariableType {
  NINGUNO
  MONTO_POR_EVENTO
  COMISION_PCT
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  CON_SENA
  GANADO
  PERDIDO
}

enum ReminderChannel {
  WHATSAPP
}

enum ReminderStatus {
  SENT
  FAILED
  SKIPPED
}

enum ReminderTrigger {
  MANUAL
  CRON
}

enum SupplyUnit {
  KG
  LITROS
  UNIDAD
}

/// Tipo de rubro de costeo (feedback 2026-10): un único catálogo en vez de
/// tres tablas. FIJO = gasto de salón prorrateado entre los eventos del mes.
enum CostCategoryKind {
  INSUMO
  SERVICIO
  FIJO
}

/// Gasto generado solo por el sistema (vs. cargado a mano).
enum ExpenseAutoSource {
  /// Empleado asignado a un evento con monto por evento trabajado.
  STAFF_EVENT
  /// Comisión del empleado que vendió el evento.
  SALE_COMMISSION
  /// Fijo + horas de una liquidación confirmada (gasto del mes).
  PAYROLL
}

enum PayrollLineKind {
  FIJO
  HORAS
  POR_EVENTO
  COMISION
  ADELANTO
  OTRO
}

/// Fase 3. Una baja de invitado lo pasa a CANCELADO (no se borra): el QR deja
/// de servir y se conserva el historial de check-in.
enum GuestStatus {
  CONFIRMADO
  CANCELADO
}

enum GuestSource {
  AUTOGESTION
  TITULAR
  ADMIN
}

/// Sin estado "duplicado": un reingreso es ADMITIDO con `note` obligatoria
/// (verificación manual) cuando ya existe un ADMITIDO previo para el invitado.
enum CheckInResult {
  ADMITIDO
  RECHAZADO
}

/// Fase 4 — trazabilidad.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Tenant {
  id   String @id @default(cuid())
  name String
  slug String @unique
  plan Plan   @default(BASICA)

  /// Perfil público del salón (Fase 3) — antes hardcodeado en la landing.
  /// Lo leen la landing y el micrositio de invitados. `tenants` no tiene RLS
  /// y app_user solo tiene SELECT: se cargan por seed/operación.
  whatsappNumber      String?
  instagramUrl        String?
  address             String?
  mapsUrl             String?
  /// Email de contacto público del salón (solo se muestra como link).
  contactEmail        String?
  /// Días antes del evento en que se cierra la confirmación autogestionada
  /// por link. Las excepciones las carga el titular/admin.
  rsvpCloseDaysBefore Int     @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  events         Event[]
  ipcIndexValues IpcIndexValue[]

  @@map("tenants")
}

/// Cuenta de una persona. Staff (admin/vendedor) y clientes conviven en la misma
/// tabla, diferenciados por `role` — así lo pidió el usuario explícitamente.
model User {
  id                 String    @id @default(cuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  email              String
  passwordHash       String
  role               Role      @default(CLIENTE)
  fullName           String
  phone              String?
  emailVerifiedAt    DateTime?
  /// true mientras el usuario tenga una contraseña temporal generada por el
  /// admin (alta de acceso de un empleado PUERTA o reseteo) — el backend le
  /// niega todo salvo cambiarla.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventAccounts        EventAccount[]
  claimedBeneficiaries EventBeneficiary[]    @relation("BeneficiaryAccount")
  createdEvents        Event[]               @relation("EventCreatedBy")
  recordedPayments     Payment[]             @relation("PaymentRecordedBy")
  triggeredIpcFetches  IpcIndexValue[]       @relation("IpcTriggeredBy")
  authTokens           AuthToken[]
  createdGuests        EventGuest[]          @relation("GuestCreatedBy")
  guestCheckIns        GuestCheckIn[]        @relation("CheckInScannedBy")
  employee             Employee?
  cardAdjustments      EventCardAdjustment[] @relation("CardAdjustedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Event {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  type             EventType
  name             String
  eventDate        DateTime?
  status           EventStatus @default(ACTIVO)
  /// Contacto del contratante cargado por el admin al crear el evento (familia
  /// en 15/boda/empresarial, colegio/comisión en egreso). Se usa para el
  /// matching automático al registrarse/loguearse con ese mismo email.
  titularName      String?
  titularEmail     String?
  /// Teléfono del contratante — sumado en Fase 2 para poder mandarle
  /// recordatorios de WhatsApp (ver módulo de recordatorios). No existía en
  /// Fase 1 porque no hacía falta para nada del portal/panel hasta ahora.
  titularPhone     String?
  /// Mínimo de invitados contratado. El avance se calcula en runtime contra
  /// COUNT(EventGuest CONFIRMADO) — no hay contador persistido (Fase 3).
  minGuests        Int?
  /// Hora de inicio "HH:mm" para la cuenta regresiva del micrositio
  /// (eventDate es solo fecha).
  startTime        String?
  /// Link externo de fotos que pasa el fotógrafo (Google Fotos u otro) — lo
  /// carga el admin, se muestra en el micrositio. Sin upload nativo.
  photosUrl        String?
  /// Empleado que vendió el evento: genera su comisión por evento vendido
  /// (feedback 2026-10 — la comisión es por venta, no por evento trabajado).
  soldByEmployeeId String?
  soldByEmployee   Employee?   @relation("EventSoldBy", fields: [soldByEmployeeId], references: [id])
  /// Fecha de la venta: define en qué mes se liquida la comisión.
  soldAt           DateTime?
  createdById      String?
  createdBy        User?       @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  beneficiaries EventBeneficiary[]
  accounts      EventAccount[]

  expenses           Expense[]
  staffAssignments   EventStaffAssignment[]
  timeEntries        EmployeeTimeEntry[]
  commissionAdvances EmployeeCommissionAdvance[]
  convertedFromLeads Lead[]
  contract           EventContract?
  guests             EventGuest[]
  guestCheckIns      GuestCheckIn[]

  @@index([tenantId])
  @@index([tenantId, titularEmail])
  @@map("events")
}

/// "A quién se factura" dentro de un evento. Para QUINCE/BODA/EMPRESARIAL se crea
/// una única fila junto con el evento (representa al evento entero). Para EGRESO
/// se crea una fila por alumno (import de Excel) — cada una con su propio
/// desglose de tarjetas y sus propios pagos, por privacidad entre familias.
model EventBeneficiary {
  id       String @id @default(cuid())
  tenantId String
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])

  /// Nombre del alumno en EGRESO; null en el resto (el beneficiario es el evento).
  label String?

  /// Email de contacto para matching automático de cuentas. Solo se usa para
  /// egreso (email por alumno/familia); en el resto el matching se resuelve
  /// vía Event.titularEmail.
  contactEmail String?
  contactPhone String?

  /// Token del link de invitación (`/i/:inviteToken`, Fase 3) — por
  /// beneficiary y no por evento: en egreso cada familia comparte el suyo y el
  /// invitado queda asociado al alumno sin exponer la lista de alumnos.
  /// Se genera la primera vez que se comparte.
  inviteToken String? @unique

  accountId String?
  account   User?   @relation("BeneficiaryAccount", fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards         EventCard[]
  payments      Payment[]
  eventAccounts EventAccount[]
  reminderLogs  ReminderLog[]
  guests        EventGuest[]

  @@index([tenantId])
  @@index([tenantId, contactEmail])
  @@map("event_beneficiaries")
}

/// Línea de desglose de tarjeta (adulto/adolescente/menor/brindis) para un
/// beneficiario. El valor "hoy" se calcula en runtime como
/// baseValue × (indexValue vigente / indexValue en basePeriod).
model EventCard {
  id            String           @id @default(cuid())
  tenantId      String
  beneficiaryId String
  beneficiary   EventBeneficiary @relation(fields: [beneficiaryId], references: [id])
  cardType      CardType
  quantity      Int
  baseValue     Decimal          @db.Decimal(12, 2)
  /// Primer día del mes (período IPC) en que se fijó baseValue.
  basePeriod    DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  /// Ajustes manuales (renegociación) — nunca un UPDATE suelto de
  /// quantity/baseValue: ver EventCardAdjustment.
  adjustments EventCardAdjustment[]

  @@unique([beneficiaryId, cardType])
  @@index([tenantId])
  @@map("event_cards")
}

/// Índice IPC obtenido automáticamente desde la API de datos.gob.ar (serie
/// 145.3_INGNACUAL_DICI_M_38), no cargado a mano. Cada fila registra el índice
/// acumulado resultante de encadenar la variación de los últimos 2 valores
/// publicados sobre el índice anterior, junto con los valores fuente usados
/// (auditoría). No se recalcula retroactivamente.
///
/// Estas filas las escribe un job programado (cron) — la pantalla de saldo del
/// cliente SIEMPRE lee el último valor ya guardado acá, nunca llama a
/// datos.gob.ar en el momento de servir la pantalla (ver docs/costos/Arquitectura
/// y costos.md).
model IpcIndexValue {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Mes del dato más reciente tomado en este fetch.
  period              DateTime
  /// Índice acumulado resultante (encadenado sobre el registro anterior).
  indexValue          Decimal  @db.Decimal(14, 6)
  sourcePreviousValue Decimal  @db.Decimal(14, 6)
  sourceLatestValue   Decimal  @db.Decimal(14, 6)

  /// Null = lo escribió el job automático. Seteado = un admin disparó un
  /// refresh manual desde el panel.
  triggeredById String?
  triggeredBy   User?    @relation("IpcTriggeredBy", fields: [triggeredById], references: [id])
  fetchedAt     DateTime @default(now())

  @@unique([tenantId, period])
  @@index([tenantId])
  @@map("ipc_index_values")
}

/// Abono registrado a mano por el admin (no hay pasarela de pago ni
/// facturación por sistema — decisión de fondo del cliente, no técnica).
model Payment {
  id            String           @id @default(cuid())
  tenantId      String
  beneficiaryId String
  beneficiary   EventBeneficiary @relation(fields: [beneficiaryId], references: [id])
  amount        Decimal          @db.Decimal(12, 2)
  paymentDate   DateTime
  note          String?
  recordedById  String?
  recordedBy    User?            @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime         @default(now())

  allocations PaymentCardAllocation[]

  @@index([tenantId])
  @@map("payments")
}

/// Qué tarjetas cubre un pago puntual — opcional (un pago puede quedar sin
/// desglosar, ej. un monto rápido de un 15 años donde no aporta nada
/// separar por tipo). Cuando se carga, permite mostrar "cuántas unidades de
/// cada tipo ya están pagas" además del saldo en $ — son dos vistas
/// complementarias, no la misma cuenta: el saldo en $ es la fuente de
/// verdad (los valores de tarjeta se actualizan por IPC), esto es una
/// lectura más humana ("faltan 2 adolescentes y 1 menor").
model PaymentCardAllocation {
  id        String   @id @default(cuid())
  tenantId  String
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  cardType  CardType
  quantity  Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, paymentId])
  @@map("payment_card_allocations")
}

/// Vínculo muchos-a-muchos cuenta↔evento con rol.
model EventAccount {
  id       String @id @default(cuid())
  tenantId String
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  /// Null = titular de EGRESO (colegio/comisión): ve el agregado del evento
  /// (mínimo de invitados, totales), no el detalle de pago de cada familia.
  /// Seteado = participante de EGRESO (su alumno) o titular de
  /// QUINCE/BODA/EMPRESARIAL (el único beneficiary del evento).
  beneficiaryId String?
  beneficiary   EventBeneficiary? @relation(fields: [beneficiaryId], references: [id])
  role          AccountRole

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([tenantId])
  @@map("event_accounts")
}

/// Token de un solo uso para verificación de email y recupero de contraseña
/// (mismo mecanismo para ambos casos, diferenciado por `purpose`).
model AuthToken {
  id        String       @id @default(cuid())
  tenantId  String
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([tenantId])
  @@index([userId, purpose])
  @@map("auth_tokens")
}

// ---------------------------------------------------------------------------
// Costeo (Plan Pro) y Personal (Básica: ABM/asignación · Pro: horas/liquidación)
// Fase 2 — ver CLAUDE.md "Fase 2 — costeo y personal" para el detalle de las
// decisiones de negocio (renegociación/tope de seña = solo alerta, personal
// auto-completa la línea de costo de servicio, Cami/Fede acceso igual).
// ---------------------------------------------------------------------------

/// Porcentajes y umbrales de costeo editables por tenant. Fila única por tenant.
model TenantCostConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  gananciaPct            Decimal @default(0.40) @db.Decimal(5, 4)
  roturaPct              Decimal @default(0.15) @db.Decimal(5, 4)
  ivaPct                 Decimal @default(0.21) @db.Decimal(5, 4)
  /// % de suba de un insumo que dispara la alerta de renegociación (solo
  /// informativa — decisión cerrada, nunca bloquea nada).
  insumoRenegotiationPct Decimal @default(0.10) @db.Decimal(5, 4)
  /// % máximo de seña anticipada sobre el total (solo informativo, ídem).
  advanceDepositCapPct   Decimal @default(0.30) @db.Decimal(5, 4)
  /// Impuestos bancarios de la hoja COSTOS de Fede: créditos y débitos
  /// (0,06% c/u, sobre el costo neto del evento) + un monto fijo por
  /// transferencia (por evento).
  bankCreditTaxPct       Decimal @default(0.0006) @db.Decimal(6, 5)
  bankDebitTaxPct        Decimal @default(0.0006) @db.Decimal(6, 5)
  bankTransferFee        Decimal @default(1000) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_cost_configs")
}

/// Rubro de costeo — catálogo único por tenant (antes eran tres tablas:
/// insumos, servicios y gastos fijos). `monthlyAmount`/`guestScaled` solo
/// aplican a los FIJO: el monto es el ESTIMADO mensual, que se usa mientras
/// no haya gastos reales cargados ese mes para el rubro. Los proveedores se
/// vinculan a un rubro (dropdown) para que todo quede relacionado.
model CostCategory {
  id            String           @id @default(cuid())
  tenantId      String
  kind          CostCategoryKind
  name          String
  sortOrder     Int              @default(0)
  monthlyAmount Decimal          @default(0) @db.Decimal(12, 2)
  guestScaled   Boolean          @default(false)

  expenses  Expense[]
  providers Provider[]
  employees Employee[]

  @@unique([tenantId, kind, name])
  @@index([tenantId])
  @@map("cost_categories")
}

/// Gasto real (un ticket/factura): de un evento puntual (`eventId`) o del
/// salón en un mes (`period`, primer día del mes — gastos fijos, liquidación
/// de personal). El costeo del evento sale de la suma de estos gastos, no de
/// un número tipeado. Ítems opcionales (estructura de la hoja PRECIOS. de
/// Fede): si hay ítems, `amount` es su suma (lo calcula el server).
/// Ticket adjunto como respaldo (sin OCR — decisión cerrada).
model Expense {
  id       String @id @default(cuid())
  tenantId String

  eventId    String?
  event      Event?        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  period     DateTime?
  date       DateTime
  categoryId String?
  category   CostCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerId String?
  provider   Provider?     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  employeeId String?
  employee   Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(12, 2)
  detail String?

  autoSource     ExpenseAutoSource?
  /// Un ajuste a mano de un gasto auto-generado no lo pisa el sistema.
  manuallyEdited Boolean            @default(false)
  payrollEntryId String?            @unique
  payrollEntry   PayrollEntry?      @relation(fields: [payrollEntryId], references: [id])

  receiptKey      String?
  receiptName     String?
  receiptMimeType String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ExpenseItem[]

  @@index([tenantId])
  @@index([tenantId, eventId])
  @@index([tenantId, period])
  @@map("expenses")
}

/// Ítem de un gasto: producto, presentación (texto libre, como en el Excel:
/// "x6", "5L"), cantidad, unidad y precio unitario.
model ExpenseItem {
  id        String  @id @default(cuid())
  tenantId  String
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  productName  String
  presentation String?
  quantity     Decimal    @db.Decimal(10, 3)
  unit         SupplyUnit @default(UNIDAD)
  unitCost     Decimal    @db.Decimal(12, 2)
  sortOrder    Int        @default(0)

  @@index([tenantId])
  @@index([tenantId, productName])
  @@map("expense_items")
}

/// Empleado del salón (Pao, Adri, etc. en el caso real de Fede).
/// `contractType` es solo clasificación/etiqueta — sin ninguna lógica
/// impositiva, mismo criterio que rige para no meterse con
/// pagos/facturación formal de clientes. La estructura de compensación
/// (fijo + variable) representa sueldo fijo puro, por evento puro, o mixto.
model Employee {
  id       String @id @default(cuid())
  tenantId String

  fullName            String
  /// Obligatorio desde Fase 3 (validado en EmployeeInputSchema). Nullable en
  /// la base solo por las filas cargadas antes de que existiera el campo.
  email               String?
  /// Login con rol PUERTA para el check-in (Fase 3). null = sin acceso.
  userId              String?              @unique
  user                User?                @relation(fields: [userId], references: [id])
  contractType        EmployeeContractType
  fixedMonthlyAmount  Decimal              @default(0) @db.Decimal(12, 2)
  /// Por evento TRABAJADO (asignación): monto fijo si MONTO_POR_EVENTO, o %
  /// del valor del evento si COMISION_PCT.
  variableType        EmployeeVariableType @default(NINGUNO)
  variableValue       Decimal              @default(0) @db.Decimal(12, 2)
  /// Por evento VENDIDO (Event.soldByEmployeeId): mismo par tipo/valor.
  saleCommissionType  EmployeeVariableType @default(NINGUNO)
  saleCommissionValue Decimal              @default(0) @db.Decimal(12, 2)
  /// Valor hora (hoja "HORAS SALON.": horas del mes × valor hora).
  hourlyRate          Decimal              @default(0) @db.Decimal(12, 2)
  /// Rubro de costeo al que van sus gastos (por evento y liquidación).
  costCategoryId      String?
  costCategory        CostCategory?        @relation(fields: [costCategoryId], references: [id])
  active              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments        EventStaffAssignment[]
  expenses           Expense[]
  eventsSold         Event[]                     @relation("EventSoldBy")
  timeEntries        EmployeeTimeEntry[]
  payrollEntries     PayrollEntry[]
  commissionAdvances EmployeeCommissionAdvance[]

  @@index([tenantId])
  @@map("employees")
}

/// Básica: solo registro de quién trabajó en qué evento, sin montos. Si el
/// empleado tiene componente variable, alta acá dispara la creación
/// automática de la línea correspondiente en EventServiceCost (ver
/// staff.service.ts).
model EventStaffAssignment {
  id       String @id @default(cuid())
  tenantId String
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  note       String?

  createdAt DateTime @default(now())

  @@unique([eventId, employeeId])
  @@index([tenantId])
  @@map("event_staff_assignments")
}

/// Pro: registro diario de horas, tomando la hoja real "HORAS SALON." de
/// Fede como referencia de estructura. `hours` nullable porque Fede a veces
/// anota texto en vez de un número ("Evento", "feriado", "-").
model EmployeeTimeEntry {
  id       String @id @default(cuid())
  tenantId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  hours      Decimal? @db.Decimal(5, 2)
  note       String?
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([tenantId])
  @@map("employee_time_entries")
}

/// Pro: liquidación por período (mes). fixedComponent = fijo prorrateado
/// del período; variableComponent = suma de variable/comisión de los
/// eventos trabajados ese período.
model PayrollEntry {
  id       String @id @default(cuid())
  tenantId String

  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  /// Primer día del mes que representa el período liquidado.
  period            DateTime
  fixedComponent    Decimal  @db.Decimal(12, 2)
  variableComponent Decimal  @db.Decimal(12, 2)
  advancesDeducted  Decimal  @default(0) @db.Decimal(12, 2)
  note              String?
  createdById       String?

  createdAt DateTime @default(now())

  commissionAdvances EmployeeCommissionAdvance[]
  lines              PayrollLine[]
  expense            Expense?

  @@unique([employeeId, period])
  @@index([tenantId])
  @@map("payroll_entries")
}

/// Pro: comisión adelantada a cuenta, registrada individualmente (así lo
/// anota Fede: "2 comisiones adelantadas", "7 comisiones adelantadas...").
/// Se reconcilia contra un PayrollEntry del período cuando se liquida.
/// Línea de una liquidación confirmada (editable antes de confirmar):
/// cantidad × unitario = monto. ADELANTO va en negativo.
model PayrollLine {
  id             String          @id @default(cuid())
  tenantId       String
  payrollEntryId String
  payrollEntry   PayrollEntry    @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  kind           PayrollLineKind
  description    String
  quantity       Decimal         @db.Decimal(10, 2)
  unitAmount     Decimal         @db.Decimal(12, 2)
  amount         Decimal         @db.Decimal(12, 2)
  sortOrder      Int             @default(0)

  @@index([tenantId])
  @@map("payroll_lines")
}

model EmployeeCommissionAdvance {
  id       String @id @default(cuid())
  tenantId String

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  amount     Decimal  @db.Decimal(12, 2)
  eventId    String?
  event      Event?   @relation(fields: [eventId], references: [id])
  note       String?

  reconciledInEntryId String?
  reconciledInEntry   PayrollEntry? @relation(fields: [reconciledInEntryId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("employee_commission_advances")
}

// ---------------------------------------------------------------------------
// CRM de consultas + Calendario de disponibilidad (Fase 2)
// Comparten el modelo Lead: una consulta "con seña" es lo que reserva
// tentativamente una fecha en el calendario antes de que exista un Event
// real — ver CLAUDE.md "Fase 2 — CRM y calendario".
// ---------------------------------------------------------------------------

model Lead {
  id       String @id @default(cuid())
  tenantId String

  fullName       String
  phone          String
  eventType      EventType
  /// Fecha tentativa que el interesado marcó en el form de la landing —
  /// opcional (puede no saber la fecha todavía). Se usa para el calendario.
  interestedDate DateTime?
  message        String?
  status         LeadStatus @default(NUEVO)
  notes          String?

  /// Seteado cuando el admin efectivamente crea el Event a partir de este
  /// lead (vía el alta normal de evento, no automático) — deja de aparecer
  /// como tentativo en el calendario, el Event real ya lo cubre.
  convertedEventId String?
  convertedEvent   Event?  @relation(fields: [convertedEventId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, interestedDate])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Contratos digitales (Fase 2) — adjunto simple, sin firma electrónica real
// (decisión cerrada: el admin sube el PDF ya firmado por otro medio). Ver
// CLAUDE.md "Fase 2 — contratos digitales".
// ---------------------------------------------------------------------------

model EventContract {
  id           String   @id @default(cuid())
  tenantId     String
  eventId      String   @unique
  event        Event    @relation(fields: [eventId], references: [id])
  fileName     String
  /// Clave para ContractStorage (apps/api/src/lib/storage.ts) — no es una
  /// URL pública, el archivo se sirve siempre por un endpoint autenticado.
  storageKey   String
  uploadedById String?
  uploadedAt   DateTime @default(now())

  @@index([tenantId])
  @@map("event_contracts")
}

// ---------------------------------------------------------------------------
// Recordatorios automáticos (Fase 2) — cadencia fija configurable por
// tenant, canal WhatsApp Business API (sin credenciales todavía — ver
// apps/api/src/lib/whatsapp.ts). Ver CLAUDE.md "Fase 2 — recordatorios".
// ---------------------------------------------------------------------------

model TenantReminderConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  enabled                     Boolean         @default(false)
  channel                     ReminderChannel @default(WHATSAPP)
  /// Recordar cada N días mientras haya saldo pendiente.
  cadenceDaysIfPendingBalance Int             @default(15)
  /// Recordar si faltan X días o menos para el evento y sigue sin saldarse.
  daysBeforeEventIfUnpaid     Int             @default(7)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("tenant_reminder_configs")
}

/// Registro de cada intento de recordatorio, exitoso o no — sirve como log
/// de auditoría y, mientras no haya WhatsApp Business API conectado, como
/// lista manual de "a quién había que escribirle y qué" (ver
/// UnconfiguredWhatsAppSender en whatsapp.ts).
model ReminderLog {
  id       String @id @default(cuid())
  tenantId String

  beneficiaryId String
  beneficiary   EventBeneficiary @relation(fields: [beneficiaryId], references: [id])
  channel       ReminderChannel
  message       String
  status        ReminderStatus
  errorMessage  String?
  trigger       ReminderTrigger

  sentAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, beneficiaryId])
  @@map("reminder_logs")
}

/// Invitado de un evento (Fase 3). Registro propio, NO es un User del sistema
/// de auth. Se crea CONFIRMADO: por autogestión desde el link de invitación o
/// cargado por el titular/admin.
model EventGuest {
  id       String @id @default(cuid())
  tenantId String

  eventId       String
  event         Event             @relation(fields: [eventId], references: [id])
  /// Familia/alumno al que pertenece (egreso). null = invitado general del evento.
  beneficiaryId String?
  beneficiary   EventBeneficiary? @relation(fields: [beneficiaryId], references: [id])

  fullName String
  phone    String?
  email    String?

  status    GuestStatus @default(CONFIRMADO)
  source    GuestSource
  /// "Entrada después de las 12": invitado cargado igual que el resto, con su
  /// propio QR — solo cambia la etiqueta que ve el personal de la puerta.
  lateEntry Boolean     @default(false)

  /// Lo que codifica el QR (aleatorio, no adivinable). El QR se dibuja en el
  /// navegador, no se guarda como imagen.
  qrToken   String @unique
  /// Código corto para ingreso manual en la puerta, único por evento.
  entryCode String

  createdById String?
  createdBy   User?   @relation("GuestCreatedBy", fields: [createdById], references: [id])

  confirmedAt DateTime  @default(now())
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checkIns GuestCheckIn[]

  @@unique([eventId, entryCode])
  @@index([tenantId])
  @@index([tenantId, eventId])
  @@index([tenantId, beneficiaryId])
  @@map("event_guests")
}

/// Un registro por decisión explícita del personal de la puerta (admitir o
/// rechazar) — escanear/buscar no escribe nada, así los reintentos de lectura
/// nunca cuentan como duplicado.
model GuestCheckIn {
  id       String @id @default(cuid())
  tenantId String

  eventId String
  event   Event      @relation(fields: [eventId], references: [id])
  guestId String
  guest   EventGuest @relation(fields: [guestId], references: [id])

  scannedById String
  scannedBy   User   @relation("CheckInScannedBy", fields: [scannedById], references: [id])

  result CheckInResult
  /// Obligatoria si es un reingreso (ya había un ADMITIDO previo): ej.
  /// "reingreso verificado con DNI", "confirmado con el titular".
  note   String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, eventId])
  @@index([tenantId, guestId])
  @@map("guest_checkins")
}

// NOTA sobre la tabla "session" (express-session / connect-pg-simple): su DDL
// está versionado a mano en la migración SQL (no en este schema, porque
// connect-pg-simple espera su propia estructura fija), para poder otorgarle
// permisos a app_user sin darle privilegios de CREATE TABLE en runtime. Ver el
// bloque de RLS/roles al final de la primera migración.

/// Ajuste MANUAL de una tarjeta (renegociación) — Fase 4. Distinto del ajuste
/// automático por IPC (IpcIndexValue): cada ajuste guarda el estado anterior
/// y el nuevo + motivo, y re-basa la tarjeta (nuevo baseValue en el período
/// actual, desde ahí sigue indexando por IPC). El saldo queda reconstruible
/// paso a paso. Se crea en la misma transacción que actualiza EventCard.
model EventCardAdjustment {
  id       String @id @default(cuid())
  tenantId String

  cardId String
  card   EventCard @relation(fields: [cardId], references: [id])

  previousQuantity   Int
  newQuantity        Int
  previousBaseValue  Decimal  @db.Decimal(12, 2)
  newBaseValue       Decimal  @db.Decimal(12, 2)
  previousBasePeriod DateTime
  newBasePeriod      DateTime
  reason             String

  createdById String
  createdBy   User     @relation("CardAdjustedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, cardId])
  @@map("event_card_adjustments")
}

/// Directorio de proveedores aliados (Fase 4, Plan Básica). Curado por el
/// salón por ABM manual. referralPct/referralNote son SOLO referencia
/// interna (no mueven dinero) y nunca salen en endpoints públicos/portal.
model Provider {
  id       String @id @default(cuid())
  tenantId String

  name            String
  /// Nombre del rubro (desnormalizado de costCategory para el listado
  /// público; antes era texto libre).
  category        String
  /// Rubro de costeo (dropdown) — vincula el proveedor con los gastos.
  costCategoryId  String?
  costCategory    CostCategory? @relation(fields: [costCategoryId], references: [id])
  /// false = proveedor interno de compras (Macro, Kristal...): no aparece en
  /// la landing ni en el portal, solo en costeo.
  showInDirectory Boolean       @default(true)
  description     String?
  contactName     String?
  phone           String?
  email           String?
  instagramUrl    String?
  websiteUrl      String?
  /// A qué tipos de evento aplica (uno o más).
  eventTypes      EventType[]
  referralPct     Decimal?      @db.Decimal(5, 2)
  referralNote    String?
  active          Boolean       @default(true)
  sortOrder       Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([tenantId])
  @@map("providers")
}

/// Sponsor de la landing (Fase 4): bloque de contenido simple, logo + link.
/// El logo se sube como archivo (interfaz de storage de contratos).
model Sponsor {
  id       String @id @default(cuid())
  tenantId String

  name      String
  /// Solo http(s).
  linkUrl   String?
  logoKey   String
  logoMime  String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("sponsors")
}

/// Registro de auditoría (Fase 4). APPEND-ONLY a nivel de base: app_user solo
/// tiene SELECT, INSERT. Se escribe en la misma transacción que el cambio.
/// Sin FKs a propósito: el log sobrevive a cambios/bajas de lo que registra,
/// y actorLabel guarda la foto del nombre/email al momento.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String

  /// null = sistema (ej. cron de IPC).
  actorUserId String?
  actorLabel  String
  /// 'Event' | 'EventCard' | 'Payment' | 'IpcIndexValue' | 'Employee' | ...
  entityType  String
  entityId    String
  /// Para el "Historial" de un evento.
  eventId     String?
  action      AuditAction
  /// Texto legible: "Pago de $40.000 a Juan Pérez".
  summary     String
  /// { campo: { de, a } } — solo campos relevantes.
  changes     Json?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, eventId])
  @@map("audit_logs")
}
