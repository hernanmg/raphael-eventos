NODE_ENV=development
PORT=3001
WEB_ORIGIN="http://localhost:5173"

# Fase 1: un solo tenant por deploy, resuelto por slug al arrancar.
TENANT_SLUG="raphael-eventos"

# Rol dueño de las tablas (DDL: migraciones, seed). NUNCA lo usa el servidor
# en runtime para servir requests.
DATABASE_URL="postgresql://postgres:postgres@localhost:5450/raphael_eventos_dev"

# Rol restringido (sin BYPASSRLS) que usa el servidor en runtime — es el que
# hace que Row-Level Security se aplique de verdad. Lo crea la primera
# migración (ver prisma/migrations/.../migration.sql); la contraseña de ahí
# es un valor de desarrollo, hay que rotarla antes de ir a producción.
APP_DATABASE_URL="postgresql://app_user:app_user_dev_only@localhost:5450/raphael_eventos_dev"

# Secreto de las cookies de sesión (express-session). Generar uno propio y largo,
# nunca reusar este valor en staging/producción.
SESSION_SECRET="replace-with-a-long-random-string"
